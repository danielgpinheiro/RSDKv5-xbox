XBE_TITLE = RSDKv5X
GEN_XISO = $(XBE_TITLE).iso
NXDK_DIR = $(CURDIR)/dependencies/xbox/nxdk
RSDKv5_DIR = $(CURDIR)/RSDKv5
NXDK_CXX = y
# SDL2 (NXDK built-in) — restore NXDK_SDL = y and -DRSDK_USE_SDL2 below to revert to the SDL2 backend
# NXDK_SDL = y

SRCS += \
	$(CURDIR)/dependencies/all/tinyxml2/tinyxml2.cpp \
	$(CURDIR)/dependencies/all/iniparser/iniparser.cpp \
	$(CURDIR)/dependencies/all/iniparser/dictionary.cpp \
	$(CURDIR)/dependencies/all/miniz/miniz.c \
	$(RSDKv5_DIR)/main.cpp \
	$(RSDKv5_DIR)/RSDK/Core/RetroEngine.cpp \
	$(RSDKv5_DIR)/RSDK/Core/Math.cpp \
	$(RSDKv5_DIR)/RSDK/Core/Reader.cpp \
	$(RSDKv5_DIR)/RSDK/Core/Link.cpp \
	$(RSDKv5_DIR)/RSDK/Core/ModAPI.cpp \
	$(RSDKv5_DIR)/RSDK/Dev/Debug.cpp \
	$(RSDKv5_DIR)/RSDK/Storage/Storage.cpp \
	$(RSDKv5_DIR)/RSDK/Storage/Text.cpp \
	$(RSDKv5_DIR)/RSDK/Graphics/Drawing.cpp \
	$(RSDKv5_DIR)/RSDK/Graphics/Scene3D.cpp \
	$(RSDKv5_DIR)/RSDK/Graphics/Animation.cpp \
	$(RSDKv5_DIR)/RSDK/Graphics/Sprite.cpp \
	$(RSDKv5_DIR)/RSDK/Graphics/Palette.cpp \
	$(RSDKv5_DIR)/RSDK/Graphics/Video.cpp \
	$(RSDKv5_DIR)/RSDK/Audio/Audio.cpp \
	$(RSDKv5_DIR)/RSDK/Input/Input.cpp \
	$(RSDKv5_DIR)/RSDK/Scene/Scene.cpp \
	$(RSDKv5_DIR)/RSDK/Scene/Collision.cpp \
	$(RSDKv5_DIR)/RSDK/Scene/Object.cpp \
	$(RSDKv5_DIR)/RSDK/Scene/Objects/DefaultObject.cpp \
	$(RSDKv5_DIR)/RSDK/Scene/Objects/DevOutput.cpp \
	$(RSDKv5_DIR)/RSDK/User/Core/UserAchievements.cpp \
	$(RSDKv5_DIR)/RSDK/User/Core/UserCore.cpp \
	$(RSDKv5_DIR)/RSDK/User/Core/UserLeaderboards.cpp \
	$(RSDKv5_DIR)/RSDK/User/Core/UserPresence.cpp \
	$(RSDKv5_DIR)/RSDK/User/Core/UserStats.cpp \
	$(RSDKv5_DIR)/RSDK/User/Core/UserStorage.cpp \
	$(CURDIR)/Game/SonicMania/Game.c \
	$(CURDIR)/Game/SonicMania/Objects/All.c

INCLUDES += \
	-I$(RSDKv5_DIR)/ \
	-I$(CURDIR)/dependencies/all/ \
	-I$(CURDIR)/dependencies/all/tinyxml2/ \
	-I$(CURDIR)/dependencies/all/iniparser/ \
	-I$(CURDIR)/dependencies/xbox/stb/ \
	-I$(CURDIR)/Game/SonicMania/ \
	-I$(CURDIR)/Game/SonicMania/Objects/

EXTRA_OFLAGS = \
	-O3 \
	-fsigned-char \
	-fpermissive

# Emit a link map so xbwatson crash dumps can be symbolized
# (tools: parse addresses against main.map; main.exe carries no symbol table)
LDFLAGS += -map:$(CURDIR)/main.map

RSDK_FLAGS = \
	-D__XBOX__ \
	-DRSDK_USE_SDL3 \
	-DSCREEN_XMAX=640 \
	-DRETRO_STANDALONE=0 \
	-DRETRO_REVISION=3 \
	-DGAME_VERSION=6 \
	-DRETRO_USE_MOD_LOADER=0 \
	-DRETRO_SFX_USE_S16 \
	-DMINIZ_NO_STDIO \
	-DMINIZ_NO_ARCHIVE_WRITING_APIS

# Build posture. Default = performance: all PrintLog compiled out
# (RETRO_DISABLE_LOG=1 — the per-line E:\log.txt I/O was a real FATX stall on
# hardware), asserts off (NDEBUG), whole-program LTO on, no debug info.
# DEBUG=y = diagnostic build: logging on, asserts on, debug info, no LTO.
# (DEBUG/LTO reuse nxdk's own Makefile conventions, included below.)
DEBUG ?= n
ifeq ($(DEBUG),y)
  EXTRA_OFLAGS += -g3
else
  RSDK_FLAGS  += -DRETRO_DISABLE_LOG=1 -DNDEBUG
  LTO := y
endif

CFLAGS	+= $(EXTRA_OFLAGS) -Wall $(INCLUDES) $(RSDK_FLAGS)

CXXFLAGS += $(CFLAGS) -Wpedantic

include $(CURDIR)/dependencies/xbox/Makefile-vorbis.nxdk
include $(CURDIR)/dependencies/xbox/Makefile-ogg.nxdk
include $(CURDIR)/dependencies/xbox/Makefile-theora.nxdk

include $(NXDK_DIR)/Makefile

# SDL3 (nxdk-sdl3 submodule) — must come after the NXDK Makefile include
include $(CURDIR)/dependencies/xbox/nxdk-sdl3/config_sdl.make

# The engine draws <10 quads per frame — shrink the XGU vertex ring from its
# 512KB default to reclaim contiguous RAM (every MB counts on 64MB)
SDL3_FLAGS += -DSDL_XGU_VERTEX_BUFFER_SIZE=131072

# xemu completes AC97 buffers on a coarse timer (~10/s); with SDL's default 2048-frame
# buffers audio throughput caps at ~20kHz and everything paced by audio (music, video)
# runs slow. 8192-frame buffers keep 10/s above the 48kHz device rate. Real hardware
# completes per-descriptor in real time — this only adds latency there; reduce for
# hardware-focused builds if SFX latency is noticeable.
SDL3_FLAGS += -DSDL_XBOXAUDIO_BUFFER_FRAMES=8192

CFLAGS   += $(SDL3_FLAGS)
CXXFLAGS += $(SDL3_FLAGS)

main.exe: libSDL3.lib

# Bundle Data.rsdk in the ISO
$(OUTPUT_DIR)/default.xbe: $(OUTPUT_DIR)/Data.rsdk $(OUTPUT_DIR)/Settings.ini stage_videos

$(OUTPUT_DIR)/Data.rsdk: $(CURDIR)/Data.rsdk | $(OUTPUT_DIR)
	cp "$<" "$@"

$(OUTPUT_DIR)/Settings.ini: $(CURDIR)/xbox/Settings.ini | $(OUTPUT_DIR)
	cp "$<" "$@"

# Optionally bundle re-encoded intro/cutscene videos as loose files at D:\Videos\.
# The engine plays them from there and skips the FMV if the folder is absent, so
# this staging is conditional and a build without Videos/ still succeeds.
.PHONY: stage_videos
stage_videos: | $(OUTPUT_DIR)
	@if [ -d "$(CURDIR)/Videos" ]; then \
	  echo "[ VIDEOS   ] staging Videos/ -> ISO"; \
	  mkdir -p "$(OUTPUT_DIR)/Videos"; \
	  cp -R "$(CURDIR)/Videos/." "$(OUTPUT_DIR)/Videos/"; \
	fi

clean_local:
	@echo clean ...
	rm -Rf ./bin
	find . -name '*.iso' -type f -delete
	find . -name '*.obj' ! -path './dependencies/xbox/nxdk/*' ! -path './dependencies/xbox/nxdk-sdl3/*' -type f -delete
	find . -name '*.d' ! -path './dependencies/xbox/nxdk/*' ! -path './dependencies/xbox/nxdk-sdl3/*' -type f -delete

clean_sdl3:
	@echo clean SDL3 ...
	rm -f $(SDL3_OBJS) libSDL3.lib
